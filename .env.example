NODE_ENV="development"
PORT=8080
COOKIE_SECRET=""
PASSWORD_SECRET=""

# DB (Postsgres)
DATABASE_URL=""

# Redis
REDIS_URL=""

# Github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL=""

# Redirects
FRONTEND_AUTH_REDIRECT_URL=""

# Seq — structured log shipping (optional)
# Set to enable pino-seq transport. Omit or leave blank to disable.
# For optional local Compose logging, enable the observability profile and set
# SEQ_URL=http://seq:80. SEQ_API_KEY is needed only for authenticated Seq.
SEQ_URL=
# SEQ_API_KEY=

# Seq receives OTLP HTTP/protobuf traces automatically when SEQ_URL is set.
# Use the reachable Seq base URL, e.g. https://seq.example.com (no ingest suffix).
LOG_LEVEL=info
OTEL_SERVICE_NAME=caho-backend
OTEL_TRACES_SAMPLER_ARG=1
OTEL_SDK_DISABLED=false
# Optional full traces endpoint for a separate collector. Seq credentials are not
# sent to an override; use OTEL_EXPORTER_OTLP_TRACES_HEADERS for its credentials.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://collector:4318/v1/traces

# Session cookie domain (optional). In production set the parent domain shared
# with the frontend (caho.com.br) so OAuth sessions reach it. Omit locally.
COOKIE_DOMAIN=

# Shared secret (32+ chars) the frontend's server sends with each player's IP so
# rate limits count players, not Vercel's egress IPs. Same value as the
# frontend's BACKEND_PROXY_SECRET. Omit locally.
FRONTEND_PROXY_SECRET=
